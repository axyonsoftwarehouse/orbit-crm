# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Orbit CRM"
# Domínio raiz para subdomínio por tenant (ex.: orbitcrm.app). Deixe vazio para desativar.
NEXT_PUBLIC_ROOT_DOMAIN=
# Exibe as credenciais de demonstração nas telas de login. Defina "false" para ocultar.
NEXT_PUBLIC_DEMO_LOGIN=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (Resend)
RESEND_API_KEY=
EMAIL_FROM="Orbit CRM <nao-responda@orbitcrm.app>"
# Contato mostrado a owner/admin quando um limite do plano é atingido
SUPPORT_EMAIL=

# Sentry (rastreio de erros). Sem DSN o Sentry fica desligado.
NEXT_PUBLIC_SENTRY_DSN=
# Fração das requisições com tracing de performance (0 a 1). 0 = só erros.
NEXT_PUBLIC_SENTRY_TRACES_RATE=0
# Upload de source maps no build (opcional; configurar na Vercel)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Super-admins (lista de e-mails separada por vírgula)
SUPER_ADMIN_EMAILS=

# IA via OpenRouter (assistente do cliente e resumo das auditorias SEO).
# Sem a chave, os recursos de IA ficam indisponíveis. As chamadas usam só
# provedores sem retenção de dados (ZDR / data_collection=deny).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Segredo dos crons (usado por /api/cron/reminders, /api/cron/seo e /api/social/publish)
CRON_SECRET=

# Publicação nativa de redes sociais
SOCIAL_NATIVE_ENABLED=false
SOCIAL_PUBLISH_BATCH_SIZE=5
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v23.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
# Opcional: URN fixa da Página (urn:li:organization:123) quando a conta for de empresa
LINKEDIN_ORGANIZATION_URN=

