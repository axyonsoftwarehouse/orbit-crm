# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Orbit CRM"
# Domínio raiz para subdomínio por tenant (ex.: orbitcrm.app). Deixe vazio para desativar.
NEXT_PUBLIC_ROOT_DOMAIN=
# Exibe as credenciais de demonstração nas telas de login. Defina "false" para ocultar.
NEXT_PUBLIC_DEMO_LOGIN=

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (Resend)
RESEND_API_KEY=
EMAIL_FROM="Orbit CRM <nao-responda@orbitcrm.app>"

# Super-admins (lista de e-mails separada por vírgula)
SUPER_ADMIN_EMAILS=

# Segredo do cron (usado por /api/cron/reminders na Vercel)
CRON_SECRET=

